[sub_resource type="GDScript" id="GDScript_dor0e"]
resource_name = "guns1"
script/source = "extends Marker3D

@export var dir: Vector3


func _ready() -> void:
	for i in get_children():
		if i is Gun:
			i.dir = dir
"

