[sub_resource type="GDScript" id="GDScript_nlw8c"]
resource_name = "label"
script/source = "extends Label

var started: bool = false


func _input(event: InputEvent) -> void:
	if Input and not started and not event is InputEventMouseMotion:
		started = true
		$AnimationPlayer.play('showw')
"

