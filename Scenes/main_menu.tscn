[sub_resource type="GDScript" id="GDScript_1xund"]
resource_name = "levels"
script/source = "extends VBoxContainer

@export var count: int = Data.max_levels
var mask: bool = false


func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"editor_mode_mask\"):
		mask = true
		print('Потвержение режима разработчика...')
	if Input.is_action_just_pressed(\"editor_mode\"):
		print('Режим разработчика включен!')
		for i in get_children():
			i.show()


func _on_visibility_changed() -> void:
	if visible:
		for j in get_children():
			j.hide()
		
		$Control.show()
		$Back.show()
		
		for i in range(min(Data.levels + 2, count + 1)):
			get_children()[i].show()
"

